    "orchestration",
    "routing",
    "gateway",
    "agent",
    "llm",
    "local"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "optionalDependencies": {
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ]
