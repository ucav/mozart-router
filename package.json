{
  "name": "mozart-router",
  "version": "0.1.2",
  "description": "Mozart: local conductor for AI agents — gateway-first orchestration and routing layer.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mozart-router": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const f='dist/cli/main.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!/'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "mozart": "node dist/cli/main.js",
    "dev": "tsx src/cli/main.ts"
  },
  "keywords": [
    "ai",
    "orchestration",
    "routing",
    "gateway",
    "agent",
    "llm",
    "local"
  ],
  "license": "MIT",
  "author": "Ucav",
  "repository": {
    "type": "git",
    "url": "https://github.com/ucav/mozart-router.git"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "optionalDependencies": {
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ]
}
