{
  "name": "mozart-router",
  "version": "0.1.0",
  "description": "Local orchestration and routing layer for AI agents — gateway-first, agent-first, integration-first.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mozart-router": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
